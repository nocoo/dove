{
  "name": "dove",
  "version": "0.4.5",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:webhook": "vitest run src/server/__tests__/isolated/",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:api": "bun run scripts/run-e2e.ts",
    "test:e2e:bdd": "npx playwright test",
    "typecheck": "tsc --noEmit",
    "lint:staged": "lint-staged",
    "gate:security": "bun run scripts/gate-security.ts",
    "gate:secrets": "bun run scripts/gate-security.ts --secrets",
    "gate:deps": "bun run scripts/gate-security.ts --deps",
    "gate:routes": "bun run scripts/check-route-coverage.ts",
    "gate:pages": "bun run scripts/check-page-coverage.ts",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "entities": "^8.0.0",
    "hono": "^4.12.31",
    "jose": "^6.2.3",
    "lucide-react": "1.25.0",
    "marked": "18.0.6",
    "nanoid": "^6.0.0",
    "postcss": "^8.5.19",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.2.0",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260718.1",
    "@happy-dom/global-registrator": "^20.11.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "^8.5.19",
    "brace-expansion": "^5.0.6",
    "ws": "^8.20.1",
    "esbuild": "^0.28.1",
    "undici": "^7.28.0"
  }
}
