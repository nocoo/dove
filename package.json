{
  "name": "dove",
  "version": "0.4.3",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:webhook": "vitest run src/server/__tests__/isolated/",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:api": "bun run scripts/run-e2e.ts",
    "test:e2e:bdd": "npx playwright test",
    "typecheck": "tsc --noEmit",
    "lint:staged": "lint-staged",
    "gate:security": "bun run scripts/gate-security.ts",
    "gate:secrets": "bun run scripts/gate-security.ts --secrets",
    "gate:deps": "bun run scripts/gate-security.ts --deps",
    "gate:routes": "bun run scripts/check-route-coverage.ts",
    "gate:pages": "bun run scripts/check-page-coverage.ts",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "entities": "^8.0.0",
    "hono": "^4.12.14",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "marked": "^15.0.0",
    "nanoid": "^5.1.7",
    "postcss": "^8.5.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.14.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.24.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
