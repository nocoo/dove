# L2: API E2E (integration tests)
# L2-routes: static gate ensuring every declared route has at least one E2E request
# G2-deps: osv-scanner on lockfile (gitleaks already ran in pre-commit)
# Routes gate runs first (cheap, fail-fast); E2E + osv in parallel after.

bun run gate:routes || exit 1

bun run test:e2e:api &
PID_L2=$!

bun run gate:deps &
PID_G2=$!

FAIL=0
wait $PID_L2 || FAIL=1
wait $PID_G2 || FAIL=1

exit $FAIL
