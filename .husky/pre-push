# L2: API E2E (integration tests)
# G2-deps: osv-scanner on lockfile (gitleaks already ran in pre-commit;
#          gate:routes / gate:pages also ran in pre-commit)
# Run in parallel, fail if either fails

bun run test:e2e:api &
PID_L2=$!

bun run gate:deps &
PID_G2=$!

FAIL=0
wait $PID_L2 || FAIL=1
wait $PID_G2 || FAIL=1

exit $FAIL
