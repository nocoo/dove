#!/usr/bin/env sh
# Husky invokes hooks with `sh -e`; re-exec under bash for snapshot orchestration.
if [ -z "${BASH_VERSION-}" ]; then
	exec bash "$0" "$@"
fi
# L1 + G2-secrets (6DQ): Git index snapshot, not the working tree.
# Export the index via checkout-index, run all L1 checks in that tree,
# and block the commit on any failure. Target wall time <30s (warm).

command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}
command -v gitleaks >/dev/null 2>&1 || {
	echo "pre-commit: gitleaks is required" >&2
	exit 1
}

set -o pipefail

snapshot=
cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# gitleaks reads the Git index; run from the repo root before isolating the snapshot.
gitleaks protect --staged --no-banner --redact

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/dove-index-XXXXXX")
git checkout-index --all --prefix="$snapshot/"
repo=$(git rev-parse --show-toplevel)

if [ ! -d "$repo/node_modules" ]; then
	echo "pre-commit: node_modules is required" >&2
	exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: staged package.json and bun.lock are required" >&2
	exit 1
fi
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
	echo "pre-commit: staged package.json/bun.lock must match the installed worktree copies" >&2
	exit 1
fi

mkdir "$snapshot/node_modules"
for entry in "$repo/node_modules"/*; do
	[ -e "$entry" ] || continue
	ln -s "$entry" "$snapshot/node_modules/${entry##*/}"
done
ln -s "$repo/node_modules/.bin" "$snapshot/node_modules/.bin"
mkdir -p "$snapshot/node_modules/.vite" "$snapshot/node_modules/.vitest" "$snapshot/.cache"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
PATH="$snapshot/node_modules/.bin:$PATH"
cd "$snapshot"

TMPDIR_HOOK="$snapshot/.cache/precommit-logs"
mkdir -p "$TMPDIR_HOOK"

run_bg() {
	local name="$1"
	shift
	( "$@" >"$TMPDIR_HOOK/$name.log" 2>&1; echo $? >"$TMPDIR_HOOK/$name.exit" ) &
	eval "PID_$name=$!"
}

wait_stage() {
	local name="$1"
	local pid_var="PID_${name}"
	local pid status
	pid=${!pid_var}
	wait "$pid" 2>/dev/null || true
	status=$(cat "$TMPDIR_HOOK/$name.exit" 2>/dev/null || echo 1)
	echo "━━━ $name (exit=$status) ━━━"
	cat "$TMPDIR_HOOK/$name.log"
	if [ "$status" -ne 0 ]; then
		echo "❌ pre-commit stage '$name' failed" >&2
		for pid in $(jobs -p 2>/dev/null); do
			kill "$pid" 2>/dev/null || true
		done
		wait 2>/dev/null || true
		exit "$status"
	fi
}

run_bg typecheck bun run typecheck
run_bg lint bun run lint
run_bg routes bun run gate:routes
run_bg pages bun run gate:pages
run_bg coverage bun run test:coverage

wait_stage typecheck
wait_stage lint
wait_stage routes
wait_stage pages
wait_stage coverage
